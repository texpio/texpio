{
  "name": "texpio",
  "private": true,
  "version": "0.1.0",
  "packageManager": "bun@1.4.4",
  "engines": {
    "node": "24.18.0",
    "bun": "1.4.4"
  },
  "type": "module",
  "scripts": {
    "probe:fixture": "node scripts/serve-probe-fixture.mjs",
    "test:probe-fixture": "node --test scripts/serve-probe-fixture.test.mjs",
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json",
    "lint": "eslint . --max-warnings 0",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "test:watch": "vitest",
    "test:run": "vitest run",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "rust:fmt": "cargo fmt --manifest-path src-tauri/Cargo.toml --all",
    "rust:fmt:check": "cargo fmt --manifest-path src-tauri/Cargo.toml --all -- --check",
    "rust:clippy": "cargo clippy --locked --manifest-path src-tauri/Cargo.toml --all-targets -- -D warnings",
    "rust:clippy:fix": "cargo clippy --locked --manifest-path src-tauri/Cargo.toml --fix --allow-dirty",
    "rust:test": "cargo test --locked --manifest-path src-tauri/Cargo.toml",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "tauri:check": "bun run typecheck && cargo check --locked --manifest-path src-tauri/Cargo.toml",
    "ast:lint": "ast-grep scan",
    "ast:test": "ast-grep test --skip-snapshot-tests",
    "ast:fix": "ast-grep scan --fix",
    "knip": "knip",
    "jscpd": "jscpd",
    "test:all": "bun run test && bun run test:tooling && bun run test:probe-fixture && bun run rust:test",
    "check:all": "bun run typecheck && bun run lint && bun run ast:lint && bun run ast:test && bun run format:check && bun run rust:fmt:check && bun run rust:clippy && bun run test:all",
    "fix:all": "bun run lint:fix && bun run format && bun run rust:fmt",
    "rust:bindings": "cargo run --locked --manifest-path src-tauri/Cargo.toml --example export_bindings",
    "test:tooling": "node --test scripts/tooling.test.js scripts/agents.test.js scripts/release-gates.test.js",
    "task:complete": "node scripts/complete-task.js",
    "release:prepare": "node scripts/prepare-release.js",
    "analyze": "bun run build && node scripts/analyze-bundle.js",
    "task:rename-done": "node scripts/complete-task.js --rename-existing"
  },
  "dependencies": {
    "@radix-ui/react-alert-dialog": "^1.2.1",
    "@radix-ui/react-checkbox": "^1.4.1",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-radio-group": "^1.5.1",
    "@radix-ui/react-scroll-area": "^1.4.0",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-separator": "^1.2.0",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.4.1",
    "@radix-ui/react-toggle": "^1.1.10",
    "@radix-ui/react-toggle-group": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.104.5",
    "@tanstack/react-query-devtools": "^5.104.5",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-clipboard-manager": "^2.5.0",
    "@tauri-apps/plugin-dialog": "^2.8.3",
    "@tauri-apps/plugin-fs": "^2.7.1",
    "@tauri-apps/plugin-log": "^2.10.1",
    "@tauri-apps/plugin-notification": "^2.7.0",
    "@tauri-apps/plugin-opener": "^2.7.2",
    "@tauri-apps/plugin-os": "^2.4.0",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-updater": "^2.14.0",
    "@tauri-apps/plugin-window-state": "^2.5.0",
    "@tiptap/core": "3.32.0",
    "@tiptap/extension-find-and-replace": "3.32.0",
    "@tiptap/extension-ordered-list": "3.32.0",
    "@tiptap/pm": "3.32.0",
    "@tiptap/react": "3.32.0",
    "@tiptap/starter-kit": "3.32.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "cn": "^0.5.0",
    "i18next": "^25.7.3",
    "lucide-react": "^1.61.0",
    "radix-ui": "^1.8.1",
    "react": "^19.1.0",
    "react-day-picker": "^9.12.0",
    "react-dom": "^19.1.0",
    "react-i18next": "^17.0.0",
    "react-resizable-panels": "^3.0.6",
    "shadcn": "^4.22.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@ast-grep/cli": "^0.42.3",
    "@babel/core": "7.29.7",
    "@eslint-react/eslint-plugin": "5.28.1",
    "@eslint/js": "^10.0.1",
    "@rolldown/plugin-babel": "^0.2.4",
    "@tauri-apps/cli": "^2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.19.2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^6.0.2",
    "@vitest/coverage-v8": "5.0.5",
    "@vitest/ui": "5.0.5",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "jscpd": "^5.4.2",
    "jsdom": "^30.1.3",
    "knip": "^6.42.1",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.0.16",
    "vitest": "^5.0.5"
  },
  "trustedDependencies": [
    "@ast-grep/cli"
  ]
}
