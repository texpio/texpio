{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "quick-pane",
  "description": "Read-only snippet picker with explicit clipboard Copy and dismissal",
  "windows": [
    "quick-pane"
  ],
  "permissions": [
    "core:event:default",
    "core:resources:default",
    "allow-load-preferences",
    "allow-migrate-legacy-theme",
    "allow-dismiss-quick-pane",
    "allow-record-diagnostic",
    "allow-library-load",
    "clipboard-manager:allow-write-text"
  ]
}
