{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "quick-pane",
  "description": "Floating entry: appearance, focus notifications, entry events, and dismissal only",
  "windows": [
    "quick-pane"
  ],
  "permissions": [
    "core:event:default",
    "core:resources:default",
    "allow-load-preferences",
    "allow-migrate-legacy-theme",
    "allow-dismiss-quick-pane"
  ]
}
