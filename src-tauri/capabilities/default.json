{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Local snippet management, explicit file dialogs and clipboard Copy; guarded native expansion starts explicitly",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:event:default",
    "core:resources:default",
    "core:menu:default",
    "os:allow-platform",
    "core:window:allow-close",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-is-maximized",
    "core:window:allow-set-fullscreen",
    "core:window:allow-is-fullscreen",
    "core:window:allow-start-dragging",
    "allow-get-app-info",
    "allow-load-preferences",
    "allow-save-preferences",
    "allow-migrate-legacy-theme",
    "allow-save-emergency-data",
    "allow-load-emergency-data",
    "allow-cleanup-old-recovery-files",
    "allow-send-native-notification",
    "allow-probe-status",
    "allow-probe-fixtures",
    "allow-probe-start",
    "allow-probe-stop",
    "allow-probe-pause",
    "allow-probe-exclude",
    "allow-show-quick-pane",
    "allow-dismiss-quick-pane",
    "allow-toggle-quick-pane",
    "allow-get-default-quick-pane-shortcut",
    "allow-update-quick-pane-shortcut",
    "allow-get-update-configuration",
    "allow-prepare-for-relaunch",
    "allow-quit-app",
    "allow-record-diagnostic",
    "updater:default",
    "process:allow-restart",
    "allow-library-load",
    "allow-library-save",
    "allow-library-export",
    "allow-library-import-preview",
    "allow-library-import",
    "allow-library-start",
    "allow-library-metadata",
    "allow-library-set-favorite",
    "allow-attachment-list",
    "allow-attachment-settings",
    "allow-library-location",
    "allow-library-switch",
    "allow-attachment-add",
    "allow-attachment-add-data",
    "allow-attachment-remove",
    "allow-attachment-reorder",
    "allow-attachment-save-settings",
    "allow-product-status",
    "allow-product-start",
    "allow-product-stop",
    "allow-product-pause",
    "allow-product-settings",
    "allow-product-save-settings",
    "clipboard-manager:allow-write-text",
    "dialog:allow-open",
    "dialog:allow-save",
    "fs:allow-read-text-file",
    "fs:allow-write-text-file",
    "fs:allow-stat"
  ]
}
