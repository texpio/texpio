{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "index.html",
    "quick-pane.html",
    "src/main.tsx",
    "src/quick-pane-main.tsx",
    "vite.config.ts",
    "vitest.config.ts",
    "scripts/*.{js,mjs}"
  ],
  "project": ["src/**/*.{ts,tsx}"],
  "ignore": [
    "src/components/ui/**",
    "src/test/**",
    "**/index.ts",
    "src/lib/platform-strings.ts",
    "src/lib/bindings.ts"
  ],
  "ignoreDependencies": [
    "@tauri-apps/*",
    "@radix-ui/*",
    "tailwindcss",
    "tw-animate-css",
    "react-day-picker",
    "@testing-library/*",
    "babel-plugin-react-compiler"
  ],
  "ignoreExportsUsedInFile": true
}
