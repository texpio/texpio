{
  "threshold": 100,
  "reporters": ["json", "console"],
  "output": "jscpd-report",
  "pattern": "**/*.{ts,tsx,rs}",
  "ignore": [
    "**/node_modules/**",
    "**/target/**",
    "**/dist/**",
    "**/*.test.{ts,tsx}",
    "**/*.spec.{ts,tsx}",
    "**/test/**",
    "src/components/ui/**",
    ".superpowers/**",
    ".tools/**",
    "src/lib/bindings.ts",
    "src-tauri/gen/**",
    "src-tauri/permissions/autogenerated/**",
    "tests/fixtures/**"
  ],
  "minLines": 10,
  "minTokens": 50,
  "gitignore": true
}
